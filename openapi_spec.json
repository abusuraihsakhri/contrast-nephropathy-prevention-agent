{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrast Nephropathy Prevention Calculator API",
    "version": "2.1.0",
    "description": "Research and educational API for the original Mehran PCI risk score, contrast-dose heuristics, and hydration planning."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/api/evaluate": {
      "post": {
        "summary": "Evaluate a contrast-exposure case",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "patient_id",
                  "weight_kg",
                  "age_years",
                  "serum_creatinine_mg_dl",
                  "egfr_ml_min",
                  "contrast_volume_ml"
                ],
                "properties": {
                  "patient_id": {"type": "string"},
                  "weight_kg": {"type": "number", "exclusiveMinimum": 0},
                  "age_years": {"type": "integer", "minimum": 0, "maximum": 150},
                  "serum_creatinine_mg_dl": {"type": "number", "exclusiveMinimum": 0},
                  "egfr_ml_min": {"type": "number", "minimum": 0},
                  "contrast_volume_ml": {"type": "number", "minimum": 0},
                  "hypotension": {"type": "boolean", "default": false},
                  "iabp": {"type": "boolean", "default": false},
                  "congestive_heart_failure": {"type": "boolean", "default": false},
                  "anemia": {"type": "boolean", "default": false},
                  "diabetes": {"type": "boolean", "default": false},
                  "is_urgent": {"type": "boolean", "default": false},
                  "preferred_fluid": {"type": "string", "enum": ["SALINE", "BICARBONATE"]},
                  "medications": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Calculated report"},
          "422": {"description": "Invalid input"}
        }
      }
    }
  }
}
